<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <FrameLayout
        android:id="@+id/glassBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_app_gradient" />

        <View
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="-110dp"
            android:background="@drawable/bg_blob_primary" />

        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="-105dp"
            android:background="@drawable/bg_blob_secondary" />

        <View
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-70dp"
            android:layout_marginBottom="48dp"
            android:background="@drawable/bg_blob_tertiary" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="2dp"
                android:paddingEnd="2dp">

                <FrameLayout
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_header_icon"
                    android:elevation="2dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_keyboard"
                        app:tint="@color/on_primary" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/app_name"
                        android:textColor="@color/on_surface"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/app_subtitle"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="14sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/languageButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/select_language"
                    android:padding="12dp"
                    android:src="@drawable/ic_language"
                    app:tint="@color/on_surface" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/statusCard"
                style="@style/StepCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="@color/glass_card">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="128dp">

                    <com.qmdeve.liquidglass.widget.LiquidGlassView
                        android:id="@+id/statusGlass"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingTop="20dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="20dp">

                        <TextView
                            android:id="@+id/statusLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_pill"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:text="@string/status_ready_label"
                            android:textColor="@color/on_primary_container"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/status_checking"
                            android:textColor="@color/on_surface"
                            android:textSize="19sp" />

                        <TextView
                            android:id="@+id/statusSupportText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/status_support_ready"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="14sp" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/StepCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Material3.LabelLarge"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_step_badge"
                            android:gravity="center"
                            android:text="@string/step_one"
                            android:textColor="@color/on_primary_container" />

                        <TextView
                            style="@style/TextAppearance.Material3.TitleLarge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/section_prepare"
                            android:textColor="@color/on_surface" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/prepare_description"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/grantBluetoothButton"
                        style="@style/PrimaryButton"
                        android:text="@string/grant_bluetooth"
                        app:icon="@drawable/ic_bluetooth" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/enableBluetoothButton"
                        style="@style/SecondaryButton"
                        android:text="@string/enable_bluetooth"
                        app:icon="@drawable/ic_bluetooth" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/StepCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Material3.LabelLarge"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_step_badge"
                            android:gravity="center"
                            android:text="@string/step_two"
                            android:textColor="@color/on_primary_container" />

                        <TextView
                            style="@style/TextAppearance.Material3.TitleLarge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/section_pair"
                            android:textColor="@color/on_surface" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/pairing_instructions"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/startPairingButton"
                        style="@style/PrimaryButton"
                        android:text="@string/start_pairing"
                        app:icon="@drawable/ic_link" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/discoverAgainButton"
                        style="@style/SecondaryButton"
                        android:text="@string/discover_again"
                        app:icon="@drawable/ic_refresh" />

                    <TextView
                        style="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/paired_devices"
                        android:textColor="@color/on_surface" />

                    <LinearLayout
                        android:id="@+id/pairedDevicesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/StepCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.Material3.LabelLarge"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_step_badge"
                            android:gravity="center"
                            android:text="@string/step_three"
                            android:textColor="@color/on_primary_container" />

                        <TextView
                            style="@style/TextAppearance.Material3.TitleLarge"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/section_overlay"
                            android:textColor="@color/on_surface" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/overlay_description"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/grantOverlayButton"
                        style="@style/PrimaryButton"
                        android:text="@string/grant_overlay"
                        app:icon="@drawable/ic_layers" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/showOverlayButton"
                        style="@style/SecondaryButton"
                        android:text="@string/show_overlay"
                        app:icon="@drawable/ic_visibility" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/hideOverlayButton"
                        style="@style/SecondaryButton"
                        android:text="@string/hide_overlay"
                        app:icon="@drawable/ic_visibility_off" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/stopServiceButton"
                        style="@style/DangerButton"
                        android:text="@string/stop_service"
                        app:icon="@drawable/ic_power" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/privacy_footer"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
